# Credenciales privadas de Mailjet: configurar en Railway, nunca en el frontend.
MAILJET_API_KEY=
MAILJET_API_SECRET=
MAILJET_SENDER=
MAILJET_SEND_NAME=US Technologies · Matriz Legal

# URL pública de Netlify; se usa en los enlaces de respuesta de cotización.
FRONTEND_URL=https://siust.netlify.app

# Destinatario fijo solicitado para los recordatorios de vencimiento.
MATRIZ_LEGAL_ALERT_EMAIL=coordinadorshyma@ust.com.mx
MATRIZ_LEGAL_URL=https://siust.netlify.app/matriz

# En Railway agrega "correo" a cada vendedor dentro de UST_USUARIOS_JSON
# para que I+D pueda enviarle reportes. No guardes aquí usuarios ni contraseñas.

# Acceso externo del portal Haas TCM de México.
# No mezclar con UST_USUARIOS_JSON; el generador --cliente-haas produce el valor.
# UST_CLIENTES_JSON=[{"usuario":"haas_cliente","areas":["cliente"],"personaId":12,"salt":"...","hash":"..."}]
# No guardar ni subir la contraseña en este archivo. UST_CLIENTE_PASSWORD solo se usa LOCALMENTE para generar el hash.
