// ===== RECEPCIÓN E INVENTARIO POR LOTE =====
model lotes_inventario {
  /// Identificación de la recepción/descarga; el saldo vigente se calcula en movimientos.
  especificaciones Json? @db.JsonB
  id                       Int                        @id @default(autoincrement())
  folio                    String                     @unique @db.VarChar(100)
  producto_id              Int
  unidad                   productos_materiales_UM
  propiedad                inventario_propiedad
  propietario_id           Int?
  condicion                inventario_condicion
  /// Solo para material recibido/apertura; si viene de producción, Calidad manda desde lotes_produccion.
  estado_calidad_recepcion inventario_estado_calidad?
  origen                   inventario_origen
  recepcion_id             Int?
  lote_produccion_id       Int?
  /// Vinculación comercial opcional para material recibido de un cliente.
  orden_venta_id           Int?
  requisicion_compra_id    Int?
  lote_externo             String?                    @db.VarChar(100)
  fecha_caducidad          DateTime?                  @db.Date
  liberado_en              DateTime?                  @db.Timestamptz(6)
  liberado_por             String?                    @db.VarChar(100)
  creado_en                DateTime                   @default(now()) @db.Timestamptz(6)
  observaciones            String?                    @db.Text
  producto                 productos_materiales       @relation(fields: [producto_id], references: [id_Produc_Mater], onDelete: Restrict)
  propietario              personas?                  @relation("inventario_propietario", fields: [propietario_id], references: [id_Persona], onDelete: Restrict)
  recepcion                lotes_llegada?             @relation(fields: [recepcion_id], references: [id], onDelete: Restrict)
  lote_produccion          lotes_produccion?          @relation(fields: [lote_produccion_id], references: [id_Lote_Produccion], onDelete: Restrict)
  orden_venta              crm_ordenes_venta?         @relation(fields: [orden_venta_id], references: [id], onDelete: Restrict)
  requisicion              requisiciones_compra?      @relation(fields: [requisicion_compra_id], references: [id_Requi_Compra], onDelete: Restrict)
  movimientos              movimientos_inventario[]
  reservas                 inventario_reservas[]
  entregas                 entrega_materiales[]
  muestras                 muestras[]

  /// Cantidad recibida/producida y saldo se calculan desde movimientos, no desde esta identidad.
  @@index([producto_id, condicion])
  @@index([propietario_id])
  @@index([recepcion_id])
  @@index([lote_produccion_id])
  @@index([orden_venta_id])
  @@index([requisicion_compra_id])
}

