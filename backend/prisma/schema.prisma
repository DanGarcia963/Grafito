  vendedor_id          Int
  tipo_venta           crm_tipo_venta
  producto_id          Int
  servicio             String                  @db.VarChar(100)
  cantidad             Decimal                 @db.Decimal(18, 4)
  unidad               productos_materiales_UM
  orden_cliente        String                  @db.VarChar(100)
  moneda               crm_moneda              @default(MXN)
  subtotal             Decimal                 @db.Decimal(18, 2)
  impuestos            Decimal                 @db.Decimal(18, 2)
  importe_total        Decimal                 @db.Decimal(18, 2)
  estado               crm_orden_venta_estado  @default(CONFIRMADA)
  fecha_confirmacion   DateTime                @default(now()) @db.Timestamptz(6)
  fecha_compromiso     DateTime?               @db.Date
  fecha_cancelacion    DateTime?               @db.Timestamptz(6)
  motivo_cancelacion   String?                 @db.Text
  observaciones        String?                 @db.Text
  creado_por           String                  @db.VarChar(100)
  creado_en            DateTime                @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime                @updatedAt @db.Timestamptz(6)
  oportunidad          crm_oportunidades?       @relation(fields: [oportunidad_id], references: [id], onDelete: Restrict)
  cotizacion           crm_cotizaciones?        @relation(fields: [cotizacion_id, oportunidad_id], references: [id, oportunidad_id], onDelete: Restrict)
  cliente              personas                @relation("crm_orden_venta_cliente", fields: [persona_id], references: [id_Persona], onDelete: Restrict)
  vendedor             personas                @relation("crm_orden_venta_vendedor", fields: [vendedor_id], references: [id_Persona], onDelete: Restrict)
