model crm_ordenes_venta {
  /// Presentación acordada; los pesos reales se registran en el lote de inventario.
  especificaciones Json? @db.JsonB
  id                   Int                     @id @default(autoincrement())
  folio                String                  @unique(map: "uq_crm_orden_venta_folio") @db.VarChar(60)
  oportunidad_id       Int?                     @unique(map: "uq_crm_orden_venta_oportunidad")
  cotizacion_id        Int?                     @unique(map: "uq_crm_orden_venta_cotizacion")
