model facturas_venta {
  id                 Int                  @id @default(autoincrement())
  folio              String               @unique @db.VarChar(100)
  orden_venta_id     Int
  uuid_externo       String?              @unique @db.VarChar(100)
  estado             factura_venta_estado @default(REGISTRADA)
  fecha_emision      DateTime             @db.Timestamptz(6)
  fecha_vencimiento  DateTime?            @db.Date
  subtotal           Decimal              @db.Decimal(18, 2)
  impuestos          Decimal              @db.Decimal(18, 2)
  total              Decimal              @db.Decimal(18, 2)
  /// Fotografía del receptor/concepto de factura externa; no catálogo duplicado.
  datos_documento    Json?
  pdf                Bytes?               @db.ByteA
  xml                Bytes?               @db.ByteA
  creado_por         String               @db.VarChar(100)
  creado_en          DateTime             @default(now()) @db.Timestamptz(6)
  cancelado_en       DateTime?            @db.Timestamptz(6)
  motivo_cancelacion String?              @db.Text
  orden_venta        crm_ordenes_venta    @relation(fields: [orden_venta_id], references: [id], onDelete: Restrict)
  aplicaciones       aplicaciones_pago[]

  /// Control documental de facturas externas, no emisión ni validación fiscal.
  /// Moneda/cliente provienen de la OV. Una factura corresponde a una OV.
  @@unique([id, orden_venta_id])
  @@index([orden_venta_id, estado])
}

model pagos_venta {
  id                    Int                 @id @default(autoincrement())
  orden_venta_id        Int
  clave_evento          String              @unique @db.VarChar(150)
  referencia            String              @db.VarChar(150)
  fecha_pago            DateTime            @db.Timestamptz(6)
  importe               Decimal             @db.Decimal(18, 2)
  metodo                String              @db.VarChar(50)
  estado                pago_venta_estado   @default(PENDIENTE_VERIFICACION)
  comprobante_nombre    String?             @db.VarChar(255)
  comprobante_mime      String?             @db.VarChar(150)
  comprobante_contenido Bytes?              @db.ByteA
  registrado_por        String              @db.VarChar(100)
  registrado_en         DateTime            @default(now()) @db.Timestamptz(6)
  confirmado_por        String?             @db.VarChar(100)
  confirmado_en         DateTime?           @db.Timestamptz(6)
  anulado_en            DateTime?           @db.Timestamptz(6)
  motivo_anulacion      String?             @db.Text
  orden_venta           crm_ordenes_venta   @relation(fields: [orden_venta_id], references: [id], onDelete: Restrict)
  aplicaciones          aplicaciones_pago[]

  /// Moneda de la OV. Un pago puede ser anticipo sin factura; anular no significa reembolsar.
  @@unique([id, orden_venta_id])
  @@index([orden_venta_id, estado, fecha_pago])
}

model aplicaciones_pago {
  id               Int            @id @default(autoincrement())
  orden_venta_id   Int
  pago_id          Int
  factura_id       Int
  importe          Decimal        @db.Decimal(18, 2)
  creado_en        DateTime       @default(now()) @db.Timestamptz(6)
  creado_por       String         @db.VarChar(100)
  anulado_en       DateTime?      @db.Timestamptz(6)
  motivo_anulacion String?        @db.Text
  pago             pagos_venta    @relation(fields: [pago_id, orden_venta_id], references: [id, orden_venta_id], onDelete: Restrict)
  factura          facturas_venta @relation(fields: [factura_id, orden_venta_id], references: [id, orden_venta_id], onDelete: Restrict)

  /// FKs compuestas impiden aplicar un pago a una factura de otra venta.
  @@index([pago_id, orden_venta_id])
  @@index([factura_id, orden_venta_id])
}

enum factura_venta_estado {
  REGISTRADA
  CANCELADA
}

enum pago_venta_estado {
  PENDIENTE_VERIFICACION
  CONFIRMADO
  ANULADO
}
