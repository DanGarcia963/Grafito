  lote                lotes_inventario          @relation(fields: [lote_inventario_id], references: [id], onDelete: Restrict)
  ubicacion           inventario_ubicaciones    @relation(fields: [ubicacion_id], references: [id], onDelete: Restrict)
  orden_produccion    ordenes_produccion        @relation(fields: [orden_produccion_id], references: [id_Orden_Produc], onDelete: Restrict)
  movimientos         movimientos_inventario[]

  /// Consumo neto se calcula desde movimientos asociados; no se duplica en un campo.
  @@index([lote_inventario_id, ubicacion_id, estado])
  @@index([ubicacion_id])
  @@index([orden_produccion_id, estado])
}

model entrega_materiales {
  id                 Int                      @id @default(autoincrement())
  entrega_id         Int
  lote_inventario_id Int
  ubicacion_id       Int
  cantidad           Decimal                  @db.Decimal(18, 4)
  /// Cantidad efectivamente aceptada por el cliente; puede diferir de la despachada.
  cantidad_recibida  Decimal?                 @db.Decimal(18, 4)
  observaciones      String?                  @db.Text
  entrega            entregas_logistica       @relation(fields: [entrega_id], references: [id_Entrega], onDelete: Restrict)
  lote               lotes_inventario         @relation(fields: [lote_inventario_id], references: [id], onDelete: Restrict)
  ubicacion          inventario_ubicaciones   @relation(fields: [ubicacion_id], references: [id], onDelete: Restrict)
  movimientos        movimientos_inventario[]

  /// No son partidas de venta: desglosan los lotes físicos de un mismo producto.
  @@unique([entrega_id, lote_inventario_id, ubicacion_id])
  @@index([lote_inventario_id])
  @@index([ubicacion_id])
}

