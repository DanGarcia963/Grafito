  ordenes_produccion   ordenes_produccion[]
  materiales_recibidos lotes_inventario[]
  entregas             entregas_logistica[]
  facturas             facturas_venta[]
  pagos                pagos_venta[]

  @@unique([cotizacion_id, oportunidad_id])
  /// Pedido confirmado = esta orden. Cumplimiento y saldo se derivan de entregas/pagos.
  /// Primera compra/recompra se calcula por fecha de órdenes válidas, no se almacena.
  @@index([persona_id, fecha_confirmacion])
  @@index([vendedor_id, fecha_confirmacion])
  @@index([producto_id])
}

