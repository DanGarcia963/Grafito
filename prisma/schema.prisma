model proyecto_investigacion {
  id_Proyect_Inves                                         Int                              @id @default(autoincrement())
  folio                                                    String                           @db.VarChar(50)
  nombre_Proyecto                                          String                           @db.VarChar(150)
  solicitante_id                                           Int
  responsable_id                                           Int
  linea_Produccion                                         String?                          @db.VarChar(50)
  prioridad                                                proyecto_investigacion_prioridad @default(MEDIA)
  fecha_Solicitud                                          DateTime                         @db.Date
  fecha_Resultado                                          DateTime?                        @db.Date
  observaciones                                            String?                          @db.Text
  personas_proyecto_investigacion_responsable_idTopersonas personas                         @relation("proyecto_investigacion_responsable_idTopersonas", fields: [responsable_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_proy_responsable")
  personas_proyecto_investigacion_solicitante_idTopersonas personas                         @relation("proyecto_investigacion_solicitante_idTopersonas", fields: [solicitante_id], references: [id_Persona], onUpdate: Restrict, map: "fk_proy_solicitante")

  @@index([responsable_id], map: "fk_proy_responsable")
  @@index([solicitante_id], map: "fk_proy_solicitante")
}

model registro_tiempos {
  id_Regist_Tiempo  Int                                 @id @default(autoincrement())
  empleado_id       Int
  fecha             DateTime                            @db.Date
  clave_Tiempo_id   String                              @db.VarChar(30)
  tiempo_Extra_Tipo registro_tiempos_tiempo_Extra_Tipo? @default(SIMPLE)
  centro_Costos     String?                             @db.VarChar(50)
  personas          personas                            @relation(fields: [empleado_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_reg_empleado")

  @@index([empleado_id], map: "fk_reg_empleado")
}

model requisiciones_compra {
  id_Requi_Compra                                         Int                               @id @default(autoincrement())
  no_Requisicion                                          String                            @db.VarChar(50)
  no_Orden_Compra                                         String?                           @db.VarChar(50)
  solicitante_id                                          Int
  proveedor_id                                            Int?
  producto_id                                             Int
  area_Solicitante                                        String?                           @db.VarChar(50)
  tipo_Compra                                             requisiciones_compra_tipo_Compra? @default(Materia_Prima)
  uso_Actividad                                           String?                           @db.Text
  fecha_Solicitud                                         DateTime                          @db.Date
  fecha_Requerimiento                                     DateTime?                         @db.Date
  fecha_Orden_Compra                                      DateTime?                         @db.Date
  fecha_Entrega_Compromiso                                DateTime?                         @db.Date
  fecha_Recepcion                                         DateTime?                         @db.Date
  cantidad_Solicitada                                     Decimal                           @db.Decimal(12, 4)
  cantidad_Recibida                                       Decimal?                          @default(0.0000) @db.Decimal(12, 4)
  costo_Unitario                                          Decimal?                          @default(0.00) @db.Decimal(12, 2)
  costo_Total                                             Decimal?                          @default(0.00) @db.Decimal(12, 2)
  moneda                                                  requisiciones_compra_moneda       @default(MXN)
  dias_Credito                                            Int?                              @default(0)
  estado                                                  requisiciones_compra_estado       @default(SOLICITADA)
  observaciones                                           String?                           @db.Text
  recibido_Por_id                                         Int?
  productos_materiales                                    productos_materiales              @relation(fields: [producto_id], references: [id_Produc_Mater], onUpdate: Restrict, map: "fk_req_producto")
  personas_requisiciones_compra_proveedor_idTopersonas    personas?                         @relation("requisiciones_compra_proveedor_idTopersonas", fields: [proveedor_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_req_proveedor")
  personas_requisiciones_compra_recibido_Por_idTopersonas personas?                         @relation("requisiciones_compra_recibido_Por_idTopersonas", fields: [recibido_Por_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_req_recibido")
  personas_requisiciones_compra_solicitante_idTopersonas  personas                          @relation("requisiciones_compra_solicitante_idTopersonas", fields: [solicitante_id], references: [id_Persona], onUpdate: Restrict, map: "fk_req_solicitante")

  @@index([producto_id], map: "fk_req_producto")
  @@index([proveedor_id], map: "fk_req_proveedor")
  @@index([recibido_Por_id], map: "fk_req_recibido")
  @@index([solicitante_id], map: "fk_req_solicitante")
}

model resultado_analisis {
