  personas_solicitudes_analisis_desarrollo_cliente_idTopersonas              personas?                                  @relation("solicitudes_analisis_desarrollo_cliente_idTopersonas", fields: [cliente_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_sol_cliente")
  personas_solicitudes_analisis_desarrollo_responsable_Analisis_idTopersonas personas?                                  @relation("solicitudes_analisis_desarrollo_responsable_Analisis_idTopersonas", fields: [responsable_Analisis_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_sol_responsable")
