  @@index([configuracion_id, indicador_id], map: "idx_kpi_resultado_config")
  @@index([periodo_inicio, estado, evaluacion], map: "idx_kpi_resultado_dashboard")
  @@index([estado, fecha_limite_captura], map: "idx_kpi_resultado_pendientes")
}

model proceso_eventos {
  id         Int      @id @default(autoincrement())
  entidad    String   @db.VarChar(16)
  entidad_id Int
  lote_id    Int?
  tanque_id  Int?
  ciclo      Int      @default(1)
  accion     String   @db.VarChar(64)
  fecha      DateTime
  detalle    String?  @db.LongText

  @@index([entidad, entidad_id, fecha])
  @@index([lote_id, fecha])
}

model proceso_tramos {
  id         Int       @id @default(autoincrement())
  entidad    String    @db.VarChar(16)
  entidad_id Int
  lote_id    Int?
  tanque_id  Int?
  ciclo      Int       @default(1)
  etapa      String    @db.VarChar(64)
  inicio     DateTime
  fin        DateTime?
  activo     String?   @unique @db.VarChar(64)

  @@index([entidad, entidad_id, ciclo])
  @@index([inicio, etapa])
  @@index([lote_id, inicio])
}

model tramites_legales {
  id_Tramite_Legal    Int                              @id @default(autoincrement())
  duracion_Tramite    Decimal                          @db.Decimal(12, 4)
  responsable_Interno String                           @db.VarChar(255)
  proveedor           String                           @db.VarChar(255)
  fecha_Expedicion    DateTime                         @db.Date
  fecha_Vencimiento   DateTime                         @db.Date
  estatus_Tramite     tramites_legales_estatus_Tramite
  documento_ID        Int
  observaciones       String                           @db.VarChar(255)
  id_Tramite_Catalogo Int
  costo_Vigencia      Decimal                          @db.Decimal(12, 4)
  costo_Por_Anio      Decimal                          @db.Decimal(12, 4)
  catalogo_tramites   catalogo_tramites                @relation(fields: [id_Tramite_Catalogo], references: [id_Tramite_Catalogo], onUpdate: Restrict, map: "fk_tramite_catalogo")
  documentos_legales  documentos_legales               @relation(fields: [documento_ID], references: [id_Documento], onUpdate: Restrict, map: "fk_tramite_documento")

  @@index([id_Tramite_Catalogo], map: "fk_tramite_catalogo")
  @@index([documento_ID], map: "fk_tramite_documento")
}

model id_ejecuciones {
  id                Int         @id @default(autoincrement())
  muestra_id        Int
  proceso_id        Int
  ciclo             Int         @default(1)
  orden             Int
  nombre            String      @db.VarChar(100)
  estandar_segundos Int?
  estandar_version  Int
  disponible_desde  DateTime?
  inicio            DateTime?
  fin               DateTime?
  inicio_por        String?     @db.VarChar(100)
  fin_por           String?     @db.VarChar(100)
  resultado         String?     @db.Text
  muestras          muestras    @relation(fields: [muestra_id], references: [id_Muestra], onUpdate: Restrict)
  id_procesos       id_procesos @relation(fields: [proceso_id], references: [id], onUpdate: Restrict)

  @@unique([muestra_id, ciclo, orden])
  @@index([inicio, proceso_id])
  @@index([proceso_id], map: "id_ejecuciones_proceso_id_fkey")
}

model id_procesos {
  id                Int              @id @default(autoincrement())
  nombre            String           @unique @db.VarChar(100)
  estandar_segundos Int?
  version           Int              @default(1)
  activo            Boolean          @default(true)
  id_ejecuciones    id_ejecuciones[]
}

model id_viabilidades {
  id       Int        @id @default(autoincrement())
  nombre   String     @unique @db.VarChar(100)
  activo   Boolean    @default(true)
  muestras muestras[]
}

