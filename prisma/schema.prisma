generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model certificado_calidad {
  id_Certif_Calidad                                      Int                                  @id @default(autoincrement())
  folio_Certificado                                      String                               @db.VarChar(50)
  no_Certificado                                         String                               @db.VarChar(50)
  lote_id                                                Int
  cliente_id                                             Int?
  solicitante_id                                         Int?
  aprobado_Por_id                                        Int?
  revisado_Por_id                                        Int?
  fecha_Emision                                          DateTime                             @db.Date
  estatus                                                certificado_calidad_estatus?         @default(EMITIDO)
  especificacion_Min                                     Decimal?                             @db.Decimal(12, 4)
  especificacion_Max                                     Decimal?                             @db.Decimal(12, 4)
  fecha_Liberacion                                       DateTime?                            @db.Date
  hora_Liberacion                                        DateTime?                            @db.Time(0)
  estatus_Calidad                                        certificado_calidad_estatus_Calidad? @default(APROBADO)
  observaciones_Calidad                                  String?                              @db.Text
  personas_certificado_calidad_aprobado_Por_idTopersonas personas?                            @relation("certificado_calidad_aprobado_Por_idTopersonas", fields: [aprobado_Por_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_cert_aprobado")
  personas_certificado_calidad_cliente_idTopersonas      personas?                            @relation("certificado_calidad_cliente_idTopersonas", fields: [cliente_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_cert_cliente")
  lotes_produccion                                       lotes_produccion                     @relation(fields: [lote_id], references: [id_Lote_Produccion], onUpdate: Restrict, map: "fk_cert_lote")
  personas_certificado_calidad_revisado_Por_idTopersonas personas?                            @relation("certificado_calidad_revisado_Por_idTopersonas", fields: [revisado_Por_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_cert_revisado")
  personas_certificado_calidad_solicitante_idTopersonas  personas?                            @relation("certificado_calidad_solicitante_idTopersonas", fields: [solicitante_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_cert_solicitante")

  @@index([aprobado_Por_id], map: "fk_cert_aprobado")
  @@index([cliente_id], map: "fk_cert_cliente")
  @@index([lote_id], map: "fk_cert_lote")
  @@index([revisado_Por_id], map: "fk_cert_revisado")
  @@index([solicitante_id], map: "fk_cert_solicitante")
}

model control_residuos {
  id_Control_Residuos   Int                 @id @default(autoincrement())
  no_Manifiesto         String              @db.VarChar(50)
  nombre_Residuo        String              @db.VarChar(100)
  empresa_Generadora_id Int?
  area_Generadora       String?             @db.VarChar(50)
  cantidad              Decimal             @db.Decimal(12, 4)
  UM                    control_residuos_UM @default(Kg)
  fecha_Salida          DateTime            @db.Date
  factor_E32            String?             @db.VarChar(50)
  costo_Gas_CMB         Decimal?            @db.Decimal(12, 2)
  personas              personas?           @relation(fields: [empresa_Generadora_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_res_empresa")

  @@index([empresa_Generadora_id], map: "fk_res_empresa")
}

model entregas_logistica {
  id_Entrega                                             Int                    @id @default(autoincrement())
  lote_id                                                Int
  orden_Produccion_id                                    Int?
  cliente_id                                             Int
  transportista_id                                       Int?
  cantidad_Recibida_Almacen                              Decimal?               @default(0.0000) @db.Decimal(12, 4)
  UM                                                     entregas_logistica_UM? @default(Kg)
  fecha_Llegada_Almacen                                  DateTime?              @db.Date
  hora_Llegada_Alamcen                                   DateTime?              @db.Time(0)
  observaciones_Almacen                                  String?                @db.Text
  cantidad_Entregada_Cliente                             Decimal?               @default(0.0000) @db.Decimal(12, 4)
  fecha_Salida_Transporte                                DateTime?              @db.Date
  hora_Salida_Transporte                                 DateTime?              @db.Time(0)
  fecha_Entrega_Cliente                                  DateTime?              @db.Date
  observaciones_Cliente                                  String?                @db.Text
  personas_entregas_logistica_cliente_idTopersonas       personas               @relation("entregas_logistica_cliente_idTopersonas", fields: [cliente_id], references: [id_Persona], onUpdate: Restrict, map: "fk_log_cliente")
  lotes_produccion                                       lotes_produccion       @relation(fields: [lote_id], references: [id_Lote_Produccion], onUpdate: Restrict, map: "fk_log_lote")
  ordenes_produccion                                     ordenes_produccion?    @relation(fields: [orden_Produccion_id], references: [id_Orden_Produc], onDelete: Restrict, onUpdate: Restrict, map: "fk_log_orden")
  personas_entregas_logistica_transportista_idTopersonas personas?              @relation("entregas_logistica_transportista_idTopersonas", fields: [transportista_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_log_transportista")

  @@index([cliente_id], map: "fk_log_cliente")
  @@index([lote_id], map: "fk_log_lote")
  @@index([orden_Produccion_id], map: "fk_log_orden")
  @@index([transportista_id], map: "fk_log_transportista")
}

model equipos_tanques {
  id_Equipos_Tanques    Int                             @id @default(autoincrement())
  codigo_Equipo         String                          @db.VarChar(50)
  nombre_Equipo         String                          @db.VarChar(100)
  tipo                  equipos_tanques_tipo
  area                  String?                         @db.VarChar(50)
  capacidad_Kg_Lt       Decimal?                        @db.Decimal(12, 2)
  status                equipos_tanques_status          @default(OPERATIVO)
  estatus_proceso       equipos_tanques_estatus_proceso
  lotes_produccion      lotes_produccion[]
  mantenimiento_equipos mantenimiento_equipos[]
  muestras              muestras[]
}

model especificaciones_producto {
  id_Especifi_Product    Int                    @id @default(autoincrement())
  producto_id            Int
  parametro_id           Int
  valor_Minimo           String?                @db.VarChar(255)
  valor_Maximo           Decimal?               @db.Decimal(12, 4)
  parametros_laboratorio parametros_laboratorio @relation(fields: [parametro_id], references: [id_Parametro], onUpdate: Restrict, map: "fk_esp_parametro")
  productos_materiales   productos_materiales   @relation(fields: [producto_id], references: [id_Produc_Mater], onUpdate: Restrict, map: "fk_esp_producto")

  @@index([parametro_id], map: "fk_esp_parametro")
  @@index([producto_id], map: "fk_esp_producto")
}

model evaluacion_proveedores {
  id_Eval_Provee      Int      @id @default(autoincrement())
  proveedor_id        Int
  linea_Produccion    String?  @db.VarChar(50)
  puntaje_Puntualidad Decimal? @default(0.00) @db.Decimal(5, 2)
  puntaje_Servicio    Decimal? @default(0.00) @db.Decimal(5, 2)
  puntaje_Precio      Decimal? @default(0.00) @db.Decimal(5, 2)
  total_evaluacion    Decimal? @default(0.00) @db.Decimal(5, 2)
  observaciones       String?  @db.Text
  personas            personas @relation(fields: [proveedor_id], references: [id_Persona], onUpdate: Restrict, map: "fk_eval_proveedor")

  @@index([proveedor_id], map: "fk_eval_proveedor")
}

model incidencias_proveedores {
  id_Inci_Provee       Int                   @id @default(autoincrement())
  no_Incidencia        String                @db.VarChar(50)
  proveedor_id         Int
  producto_id          Int?
  lote                 String?               @db.VarChar(50)
  linea_Produccion     String?               @db.VarChar(50)
  motivo_Descripcion   String?               @db.Text
  accion_Tomada        String?               @db.Text
  productos_materiales productos_materiales? @relation(fields: [producto_id], references: [id_Produc_Mater], onDelete: Restrict, onUpdate: Restrict, map: "fk_inci_producto")
  personas             personas              @relation(fields: [proveedor_id], references: [id_Persona], onUpdate: Restrict, map: "fk_inci_proveedor")

  @@index([producto_id], map: "fk_inci_producto")
  @@index([proveedor_id], map: "fk_inci_proveedor")
}

model lote_consumo_insumo {
  id_Lote_Consumo_Insumo Int                  @id @default(autoincrement())
  lote_Padre_id          Int
  MP_id                  Int
  lote_MP_id             String?              @db.VarChar(50)
  cantidad_Consumida     Decimal              @db.Decimal(12, 4)
  lotes_produccion       lotes_produccion     @relation(fields: [lote_Padre_id], references: [id_Lote_Produccion], onUpdate: Restrict, map: "fk_con_lote_padre")
  productos_materiales   productos_materiales @relation(fields: [MP_id], references: [id_Produc_Mater], onUpdate: Restrict, map: "fk_con_mp")

  @@index([lote_Padre_id], map: "fk_con_lote_padre")
  @@index([MP_id], map: "fk_con_mp")
}

model lotes_produccion {
  id_Lote_Produccion       Int                            @id @default(autoincrement())
  no_Lote                  String                         @db.VarChar(50)
  orden_Produccion_id      Int
  tanque_id                Int?
  producto_id              Int
  cantidad_Total_Producida Decimal?                       @default(0.0000) @db.Decimal(12, 4)
  bitacora                 String?                        @db.LongText
  fecha_Fabricacion        DateTime?                      @db.Date
  fecha_Caducidad          DateTime?                      @db.Date
  estado_Calida            lotes_produccion_estado_Calida @default(PROCESANDO)
  observaciones_Calidad    String?                        @db.Text
  certificado_calidad      certificado_calidad[]
  entregas_logistica       entregas_logistica[]
  lote_consumo_insumo      lote_consumo_insumo[]
  ordenes_produccion       ordenes_produccion             @relation(fields: [orden_Produccion_id], references: [id_Orden_Produc], onUpdate: Restrict, map: "fk_lote_orden")
  productos_materiales     productos_materiales           @relation(fields: [producto_id], references: [id_Produc_Mater], onDelete: Cascade, onUpdate: Restrict, map: "fk_lote_producto")
  equipos_tanques          equipos_tanques?               @relation(fields: [tanque_id], references: [id_Equipos_Tanques], onDelete: Restrict, onUpdate: Restrict, map: "fk_lote_tanque")
  muestras                 muestras[]
  no_conformidades         no_conformidades[]

  @@index([producto_id], map: "fk_lote_producto")
  @@index([tanque_id], map: "fk_lote_tanque")
  @@index([orden_Produccion_id], map: "fk_lote_orden")
}

model mantenimiento_equipos {
  id_Manten_Equipo   Int                           @id @default(autoincrement())
  Equipo_id          Int
  actividad_Trabajo  String                        @db.Text
  semana_Anio        String?                       @db.VarChar(10)
  fecha_Programada   DateTime                      @db.Date
  fecha_Reprogramada DateTime?                     @db.Date
  fecha_Cierrre      DateTime?                     @db.Date
  estado             mantenimiento_equipos_estado? @default(PROGRAMADO)
  equipos_tanques    equipos_tanques               @relation(fields: [Equipo_id], references: [id_Equipos_Tanques], onUpdate: Restrict, map: "fk_mant_equipo")

  @@index([Equipo_id], map: "fk_mant_equipo")
}

model movimientos_inventario {
  id_Movi_Invent                                           Int                  @id @default(autoincrement())
  folio_Movi                                               String               @db.VarChar(50)
  material_id                                              Int
  cantidad                                                 Decimal              @db.Decimal(12, 4)
  area_Solicita                                            String?              @db.VarChar(50)
  solicitante_id                                           Int?
  entrega_id                                               Int?
  recibe_id                                                Int?
  autoriza_id                                              Int?
  fecha_Salida                                             DateTime             @db.Date
  hora_Salida                                              DateTime?            @db.Time(0)
  es_Prestamo                                              Boolean?             @default(false)
  fecha_Regreso_Estimada                                   DateTime?            @db.Date
  observaciones                                            String?              @db.Text
  personas_movimientos_inventario_autoriza_idTopersonas    personas?            @relation("movimientos_inventario_autoriza_idTopersonas", fields: [autoriza_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_mov_autoriza")
  personas_movimientos_inventario_entrega_idTopersonas     personas?            @relation("movimientos_inventario_entrega_idTopersonas", fields: [entrega_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_mov_entrega")
  productos_materiales                                     productos_materiales @relation(fields: [material_id], references: [id_Produc_Mater], onUpdate: Restrict, map: "fk_mov_material")
  personas_movimientos_inventario_recibe_idTopersonas      personas?            @relation("movimientos_inventario_recibe_idTopersonas", fields: [recibe_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_mov_recibe")
  personas_movimientos_inventario_solicitante_idTopersonas personas?            @relation("movimientos_inventario_solicitante_idTopersonas", fields: [solicitante_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_mov_solicitante")

  @@index([autoriza_id], map: "fk_mov_autoriza")
  @@index([entrega_id], map: "fk_mov_entrega")
  @@index([material_id], map: "fk_mov_material")
  @@index([recibe_id], map: "fk_mov_recibe")
  @@index([solicitante_id], map: "fk_mov_solicitante")
}

model muestras {
  id_Muestra                               Int                        @id @default(autoincrement())
  no_Muestra                               String                     @db.VarChar(50)
  fecha_Toma                               DateTime                   @db.Date
  Hora_Toma                                DateTime?                  @db.Time(0)
  procedencia_Origen                       String?                    @db.VarChar(50)
  lote_id                                  Int?
  producto_id                              Int
  proveedor_id                             Int?
  cliente_id                               Int?
  tanque_id                                Int?
  analista_id                              Int?
  etapa_Muestra                            muestras_etapa_Muestra?    @default(EN_PROCESO)
  estado_Muestra                           muestras_estado_Muestra    @default(PENDIENTE)
  categoria_Muestra                        muestras_categoria_Muestra @default(MUESTRA_INICIAL)
  observaciones                            String?                    @db.Text
  area_Muestra                             String                     @default("CALIDAD") @db.VarChar(24)
  vendedor_id                              Int?
  caracterizacion                          String?                    @db.VarChar(20)
  cantidad_proyecto                        Decimal?                   @db.Decimal(14, 4)
  unidad_proyecto                          String?                    @db.VarChar(30)
  viabilidad_id                            Int?
  viabilidad_nombre                        String?                    @db.VarChar(100)
  fecha_recoleccion                        DateTime?
  fecha_ingreso_laboratorio                DateTime?
  ficha_nombre                             String?                    @db.VarChar(200)
  ficha_mime                               String?                    @db.VarChar(100)
  ficha_contenido                          Bytes?                     @db.MediumBlob
  id_ejecuciones                           id_ejecuciones[]
  personas_muestras_analista_idTopersonas  personas?                  @relation("muestras_analista_idTopersonas", fields: [analista_id], references: [id_Persona], onDelete: Cascade, onUpdate: Restrict, map: "fk_muestras_personas_analista")
  personas_muestras_cliente_idTopersonas   personas?                  @relation("muestras_cliente_idTopersonas", fields: [cliente_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_muestra_cliente_rel")
  lotes_produccion                         lotes_produccion?          @relation(fields: [lote_id], references: [id_Lote_Produccion], onDelete: Restrict, onUpdate: Restrict, map: "fk_muestra_lote_rel")
  productos_materiales                     productos_materiales       @relation(fields: [producto_id], references: [id_Produc_Mater], onUpdate: Restrict, map: "fk_muestra_producto_rel")
  personas_muestras_proveedor_idTopersonas personas?                  @relation("muestras_proveedor_idTopersonas", fields: [proveedor_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_muestra_proveedor")
  equipos_tanques                          equipos_tanques?           @relation(fields: [tanque_id], references: [id_Equipos_Tanques], onDelete: Restrict, onUpdate: Restrict, map: "fk_muestra_tanque_rel")
  personas_muestras_vendedor_idTopersonas  personas?                  @relation("muestras_vendedor_idTopersonas", fields: [vendedor_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict)
  id_viabilidades                          id_viabilidades?           @relation(fields: [viabilidad_id], references: [id], onDelete: Restrict, onUpdate: Restrict)
  resultado_analisis                       resultado_analisis[]

  @@index([analista_id], map: "fk_muestra_analista")
  @@index([cliente_id], map: "fk_muestra_cliente")
  @@index([lote_id], map: "fk_muestra_lote")
  @@index([producto_id], map: "fk_muestra_producto")
  @@index([proveedor_id], map: "fk_muestra_proveedor")
  @@index([tanque_id], map: "fk_muestra_tanque")
  @@index([area_Muestra, vendedor_id])
  @@index([vendedor_id], map: "muestras_vendedor_id_fkey")
  @@index([viabilidad_id], map: "muestras_viabilidad_id_fkey")
}

model no_conformidades {
  id_NC                                                   Int                             @id @default(autoincrement())
  folio_NC                                                String                          @db.VarChar(50)
  tipo                                                    no_conformidades_tipo
  fecha                                                   DateTime                        @db.Date
  fuente_Incidencia                                       String?                         @db.VarChar(100)
  proceso_Linea                                           String?                         @db.VarChar(50)
  puesto_Notifica_id                                      Int?
  lote_id                                                 Int?
  producto_id                                             Int?
  no_Orden_Produccion                                     String?                         @db.VarChar(50)
  tipo_Envase                                             String?                         @db.VarChar(50)
  transporte_Limpio                                       Boolean?                        @default(true)
  mangueras_Limpias                                       Boolean?                        @default(true)
  sin_Fisuras_Perforaciones                               Boolean?                        @default(true)
  inspector_id                                            Int?
  aprobado_Por_id                                         Int?
  especificaciones_NC                                     String?                         @db.Text
  descripcion_NC                                          String?                         @db.Text
  causa_Raiz                                              String?                         @db.Text
  accion_Contencion                                       String?                         @db.Text
  efectividad_Accion                                      String?                         @db.Text
  responsable_id                                          Int?
  autoridad_Libera_id                                     Int?
  fecha_Inicio_Plan                                       DateTime?                       @db.Date
  fecha_Termino_Plan                                      DateTime?                       @db.Date
  fecha_Termino_Real                                      DateTime?                       @db.Date
  estado_Actual                                           no_conformidades_estado_Actual? @default(ABIERTA)
  observaciones                                           String?                         @db.Text
  personas_no_conformidades_aprobado_Por_idTopersonas     personas?                       @relation("no_conformidades_aprobado_Por_idTopersonas", fields: [aprobado_Por_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_aprobado")
  personas_no_conformidades_autoridad_Libera_idTopersonas personas?                       @relation("no_conformidades_autoridad_Libera_idTopersonas", fields: [autoridad_Libera_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_autoridad")
  personas_no_conformidades_inspector_idTopersonas        personas?                       @relation("no_conformidades_inspector_idTopersonas", fields: [inspector_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_inspector")
  lotes_produccion                                        lotes_produccion?               @relation(fields: [lote_id], references: [id_Lote_Produccion], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_lote")
  productos_materiales                                    productos_materiales?           @relation(fields: [producto_id], references: [id_Produc_Mater], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_producto")
  personas_no_conformidades_puesto_Notifica_idTopersonas  personas?                       @relation("no_conformidades_puesto_Notifica_idTopersonas", fields: [puesto_Notifica_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_puesto")
  personas_no_conformidades_responsable_idTopersonas      personas?                       @relation("no_conformidades_responsable_idTopersonas", fields: [responsable_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_nc_responsable")

  @@index([aprobado_Por_id], map: "fk_nc_aprobado")
  @@index([autoridad_Libera_id], map: "fk_nc_autoridad")
  @@index([inspector_id], map: "fk_nc_inspector")
  @@index([lote_id], map: "fk_nc_lote")
  @@index([producto_id], map: "fk_nc_producto")
  @@index([puesto_Notifica_id], map: "fk_nc_puesto")
  @@index([responsable_id], map: "fk_nc_responsable")
}

model ordenes_produccion {
  id_Orden_Produc                                   Int                              @id @default(autoincrement())
  id_Venta_Origen                                   Int?
  vendedor_id                                       Int?
  cliente_id                                        Int?
  producto_id                                       Int
  linea_Produccion                                  String?                          @db.VarChar(50)
  servicio                                          String                           @db.VarChar(50)
  cantidad_Venta                                    Int
  observaciones                                     String?                          @db.Text
  fecha_Compromiso                                  DateTime?                        @db.Date
  fecha_Confirmacion                                DateTime?                        @db.DateTime(0)
  fecha_Llegada                                     DateTime?                        @db.DateTime(0)
  no_Orden_Produc                                   String?                          @db.VarChar(50)
  cantidad_Planificada                              Decimal?                         @db.Decimal(12, 4)
  fecha_Termino_Plan                                DateTime?                        @db.Date
  inconformidad_Planeacion                          String?                          @db.VarChar(255)
  Observaciones_Planeacion                          String?                          @db.Text
  status_Produccion                                 String                           @db.VarChar(255)
  fecha_Inicio_Produccion                           DateTime?                        @db.DateTime(0)
  fecha_Termino_Real                                DateTime?                        @db.DateTime(0)
  cantidad_Producida                                Int
  observaciones_Produccion                          String?                          @db.Text
  fecha_Inicio_Plan                                 DateTime?                        @db.Date
  estado_Plan                                       ordenes_produccion_estado_Plan   @default(PLANIFICADA)
  tipo_Operacion                                    String?                          @db.VarChar(50)
  urgencia                                          ordenes_produccion_urgencia      @default(NORMAL)
  estatus_flujo                                     ordenes_produccion_estatus_flujo @default(ventas)
  entregas_logistica                                entregas_logistica[]
  lotes_llegada                                     lotes_llegada[]
  lotes_produccion                                  lotes_produccion[]
  personas_ordenes_produccion_cliente_idTopersonas  personas?                        @relation("ordenes_produccion_cliente_idTopersonas", fields: [cliente_id], references: [id_Persona], onDelete: Restrict, onUpdate: Restrict, map: "fk_ord_cliente")
  productos_materiales                              productos_materiales             @relation(fields: [producto_id], references: [id_Produc_Mater], onDelete: Cascade, onUpdate: Restrict, map: "fk_ord_producto")
